app/build/
app/.flutter-plugins*
app/.packages
app/pubspec.lock.bak

# Editors / OS
.idea/
*.swp
.DS_Store

# Local data
/data/
*.sqlite
*.log

# End-to-end tests
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
