# Copy to .env and fill in. NEVER commit the real .env.

# Public hostname the web app is served on
YAP_DOMAIN=yap.leafyserver.tech

# Postgres
POSTGRES_USER=yappitron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yappitron
DATABASE_URL=postgres://yappitron:change-me@postgres:5432/yappitron

# Gateway
YAP_BIND=0.0.0.0:8080

# 32+ random bytes, base64. Keys the email HMAC and the OPAQUE server setup.
# Generate with: openssl rand -base64 48
# LOSING THIS MEANS NOBODY CAN LOG IN. Back it up separately from the database.
YAP_SERVER_SECRET=

# Outbound email (SMTP relay, e.g. Resend). Used for verification and password reset.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@leafyserver.tech

# Cloudflare API token scoped to Zone:DNS:Edit for this one zone (Caddy DNS-01 certificates)
CLOUDFLARE_API_TOKEN=

# Optional: how many emailed codes one client address may request per hour (default 10).
# YAP_CODE_LIMIT_PER_IP=10

# Encrypted attachments (photos, videos, files). Files are stored here, NOT in Postgres: point it
# at a big disk or a NAS mount. The directory must be writable by the gateway user (uid 10001).
# Unset = attachments off.
# YAP_BLOB_DIR=/var/lib/yappitron/blobs
# YAP_MAX_BLOB_MB=100
# YAP_BLOB_QUOTA_GB=20

# Link previews: the gateway fetches pages for senders who opt in. `off` disables it entirely.
# YAP_LINK_PREVIEWS=on
# NEVER set YAP_DEV_LINK_PREVIEW_PRIVATE in production (it lets users reach your internal network).
